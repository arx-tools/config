{
  // this file exists for the editors only: visual studio code discovers the `tsconfig.json` files and
  // ignores the folder specific ones. for the actual checks look at `tsconfig.src.json` and
  // `tsconfig.tests.json` — the build and the `typecheck` script always pass an explicit `-p` flag
  "extends": "./tsconfig.src.json",
  "compilerOptions": {
    "noEmit": true,
    "incremental": false,
    "rootDir": "."
  },
  "include": ["src/**/*", "tests/**/*", "xo.config.ts"]
}
